<mujoco model="racesim_world">
  <compiler angle="degree" autolimits="true"/>
  <option timestep="0.02" gravity="0 0 -9.81"/>

  <include file="car.xml"/>

  <asset>
    <texture name="grid" type="2d" builtin="checker" width="512" height="512"
             rgb1="0.16 0.18 0.17" rgb2="0.20 0.22 0.21"/>
    <material name="ground" texture="grid" texrepeat="12 12" reflectance="0.05"/>
  </asset>

  <worldbody>
    <light name="sun" pos="0 0 12" dir="0 0 -1" diffuse="0.9 0.9 0.9"/>
    <geom name="ground" type="plane" size="80 80 0.1" material="ground"/>
    <camera name="topdown" pos="0 0 55" xyaxes="1 0 0 0 1 0"/>
    <camera name="follow" mode="trackcom" target="car" pos="-5 0 3" xyaxes="0 -1 0 0.5 0 0.866"/>
  </worldbody>
</mujoco>
