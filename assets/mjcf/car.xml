<mujoco model="simple_car">
  <default>
    <geom friction="1.2 0.02 0.001" density="600"/>
    <joint damping="0.1"/>
  </default>

  <asset>
    <material name="chassis_blue" rgba="0.05 0.18 0.55 1"/>
    <material name="wheel_dark" rgba="0.02 0.02 0.025 1"/>
  </asset>

  <worldbody>
    <body name="car" pos="0 0 0.28">
      <freejoint name="root"/>
      <geom name="chassis" type="box" size="0.9 0.45 0.12" material="chassis_blue"/>
      <geom name="nose" type="box" pos="0.75 0 0.02" size="0.45 0.25 0.06" material="chassis_blue"/>
      <geom name="rear_wing" type="box" pos="-0.85 0 0.22" size="0.08 0.55 0.04" material="chassis_blue"/>

      <body name="front_left_wheel" pos="0.65 0.48 -0.12">
        <joint name="front_left_spin" type="hinge" axis="0 1 0"/>
        <geom type="cylinder" size="0.18 0.08" euler="90 0 0" material="wheel_dark"/>
      </body>
      <body name="front_right_wheel" pos="0.65 -0.48 -0.12">
        <joint name="front_right_spin" type="hinge" axis="0 1 0"/>
        <geom type="cylinder" size="0.18 0.08" euler="90 0 0" material="wheel_dark"/>
      </body>
      <body name="rear_left_wheel" pos="-0.65 0.48 -0.12">
        <joint name="rear_left_spin" type="hinge" axis="0 1 0"/>
        <geom type="cylinder" size="0.18 0.08" euler="90 0 0" material="wheel_dark"/>
      </body>
      <body name="rear_right_wheel" pos="-0.65 -0.48 -0.12">
        <joint name="rear_right_spin" type="hinge" axis="0 1 0"/>
        <geom type="cylinder" size="0.18 0.08" euler="90 0 0" material="wheel_dark"/>
      </body>
    </body>
  </worldbody>
</mujoco>
